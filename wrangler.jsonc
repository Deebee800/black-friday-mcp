{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackfridaymcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [{ "pattern": "blackfridaymcp.com", "custom_domain": true }],
  "observability": { "logs": { "enabled": true } },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp*", "/.well-known/*", "/authorize*", "/oauth/*", "/healthz", "/admin/*"]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "03c1f3bf12ef4e1e9ead449cc937372e" },
    { "binding": "CACHE_KV", "id": "8f6ba45affd447178abc69a830d15370" }
  ],
  "ratelimits": [
    { "name": "INSTALL_RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "Gate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://blackfridaymcp.com",
    "ENVIRONMENT": "production"
  }
}
